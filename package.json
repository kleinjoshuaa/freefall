    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "latest",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
